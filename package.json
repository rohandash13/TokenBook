{
  "name": "trueup",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"tsx watch src/server/index.ts\" \"vite --config web/vite.config.ts\"",
    "gen": "tsx src/fixtures/generate.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json && tsc -p web/tsconfig.json",
    "slack": "tsx src/slack/app.ts",
    "signals": "tsx src/signals/refresh.ts",
    "demo:reset": "tsx src/server/demoReset.ts",
    "seed:demo": "tsx src/demo/seed.ts",
    "eval:signals": "tsx src/demo/evalSignals.ts",
    "eval:history": "tsx src/demo/evalHistory.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@slack/bolt": "^5.1.0",
    "@slack/web-api": "^8.2.0",
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
