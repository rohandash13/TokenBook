{
  "name": "countersign",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json",
    "dev:arena": "tsx packages/arena/src/main.ts",
    "dev:gateway": "tsx packages/gateway/src/main.ts",
    "worker": "tsx packages/worker/launch/run.ts",
    "bench": "tsx packages/bench/src/run.ts",
    "dev:dashboard": "pnpm --filter @countersign/dashboard dev",
    "build:dashboard": "pnpm --filter @countersign/dashboard build",
    "demo": "tsx scripts/demo.ts",
    "dev:convex": "convex dev",
    "demo:repeat": "tsx scripts/demo-repeat.ts"
  },
  "devDependencies": {
    "@countersign/arena": "workspace:*",
    "@countersign/gateway": "workspace:*",
    "@countersign/rules": "workspace:*",
    "@countersign/shared": "workspace:*",
    "@countersign/worker": "workspace:*",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "convex": "^1.48.0"
  }
}
