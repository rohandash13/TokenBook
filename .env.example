# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Slack (create app at api.slack.com — Socket Mode, DM permission)
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_SIGNING_SECRET=

# Slack lead member IDs (from their Slack profile)
SLACK_LEAD_SUPPORT=
SLACK_LEAD_SEARCH=
SLACK_LEAD_GROWTH=
SLACK_LEAD_PLATFORM=

# Optional overrides
TRUEUP_API_URL=http://localhost:8787
PORT=8787
SLACK_TRIGGER_PORT=8788

# Optional local read-only GitHub access via an existing gh auth login (no token copy).
GITHUB_USE_CLI=0
