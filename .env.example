# Names only. Copy to .env and fill in locally. Never commit .env.
ANTHROPIC_API_KEY=
JUDGE_MODEL=
# Optional: USD per million tokens for JUDGE_MODEL, copied from Anthropic's pricing page. Unset = judge cost recorded as unknown (null).
JUDGE_INPUT_USD_PER_MTOK=
JUDGE_OUTPUT_USD_PER_MTOK=
ATTACKER_MODEL=
WORKER_MODEL=
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=
X402_NETWORK=base-sepolia
CRS_USERNAME=
CRS_PASSWORD=
CONVEX_URL=
# Simulated executor <-> arena shared secret. Any random string. Gateway and arena only, never the worker.
SIM_PAYER_SECRET=
EXECUTOR=simulated
GATEWAY_PORT=4000
GATEWAY_HOST=127.0.0.1
# Optional: lifetime of proposed Tier 1 rules in ms. Unset = 7 days.
RULE_TTL_MS=
ARENA_PORT=4101
GATEWAY_URL=http://127.0.0.1:4000
